# Use local for offline SQLite/media development; use remote for PostgreSQL/Supabase.
APP_ENV=local

# Optional in local mode. Required and unique in remote mode.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# Keep true when using either SQLite or remote Supabase through localhost.
# Omit or set false in Vercel/production.
LOCAL_HTTP=True

# PostgreSQL only. Supabase connections should include sslmode=require.
# These database and Supabase values are ignored by the default local mode.
DATABASE_URL=postgresql://postgres:password@localhost:5432/vlsmatic
DATABASE_SSL_REQUIRE=False

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Server-side Supabase Storage configuration for persistent profile photos.
# Keep the secret key server-only; never expose it in browser code.
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-secret-key
SUPABASE_PROFILE_BUCKET=profile-photos
PROFILE_PHOTO_STORAGE=local
