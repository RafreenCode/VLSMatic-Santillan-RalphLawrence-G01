# Generate a unique value for every environment. Never commit the real secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True

# PostgreSQL only. Supabase connections should include sslmode=require.
DATABASE_URL=postgresql://postgres:password@localhost:5432/vlsmatic
DATABASE_SSL_REQUIRE=False

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Server-side Supabase Storage configuration for persistent profile photos.
# Keep the secret key server-only; never expose it in browser code.
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-secret-key
SUPABASE_PROFILE_BUCKET=profile-photos
